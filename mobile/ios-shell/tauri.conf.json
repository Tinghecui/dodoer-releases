{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coteam",
  "version": "1.0.0",
  "identifier": "ai.coteam.app",
  "build": {
    "frontendDist": "launcher"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "iOS": {
      "bundleVersion": "2611230000"
    }
  }
}
