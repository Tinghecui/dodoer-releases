# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
tsconfig.tsbuildinfo

# Next.js
.next/
out/
next-env.d.ts

# Monaco editor local files (copied from node_modules)
public/vs

# PDF.js runtime files: worker, CMaps, standard fonts, wasm decoders, ICC
# profiles (copied from node_modules by postinstall; see src/lib/pdfjs.ts)
public/pdfjs

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test artifacts
coverage/
*.snap.new
.vitest-cache/

# macOS signing material. Keep certificates and exported private keys out of git.
*.cer
*.csr
*.p12
certificate-base64.txt

# Agent
.claude
.docs
docs/superpowers

# Tauri sidecar staging (built per-target by prepare-sidecars.mjs).
# The binaries are platform-specific build artifacts; ship them through
# release.yml, not git.
src-tauri/binaries/

# pnpm local store (pnpm 11+)
.pnpm-store/

# `rustc foo.rs` with no -o writes its binary here. Scratch compiles are how
# you check a borrow or a lifetime question in isolation, and the leftover
# executable then sits untracked in the repo root — which is enough to fail a
# work task's "worktree is clean" check at delivery.
/rust_out

# Private physical-device evidence and local build diagnostics.
/mobile/evidence/

# Machine configuration, private notes, evidence, and historical experiments.
.env
.env.*
!.env.example
*.pem
*.key
/mobile/
/tasks/
/local-history/
/SOURCE-INDEX.md
/bs docs/

# Keep product documentation; new investigation material stays local by default.
/docs/*
!/docs/CLIENT-PRIVACY.md
!/docs/agent-chrome.md
!/docs/agents/
!/docs/chat-channels/
!/docs/cli.md
!/docs/conversation-mindmap.md
!/docs/host-ssh.md
!/docs/images/
!/docs/proxy-auth.md
!/docs/readme/
!/docs/remote-browser.md
!/docs/releasing/
!/docs/url-scheme.md
